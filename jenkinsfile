pipeline {
    agent any
    stages {
        stage('Build') {
            steps {
                sh 'docker build -t screw2perfect/microservice:v1 .'
            }
        }
        stage('Push to Docker Hub') {
            steps {
                sh 'docker login -u "screw2perfect" -p "@Klnh4&b2DH"' 
                sh 'docker push screw2perfect/microservice:v1'
            }
        }
        stage('Deploy to Kubernetes') {
            steps {
                echo "kubectl apply -f microservice-pod.yaml"
                echo "Successfully deployed to Kubernetes cluster!"
            }
        }
    }
}
